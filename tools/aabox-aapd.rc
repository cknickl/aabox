# Android init service for AABox — Android 12 (Radxa Rock 5B+) variant.
# Goes to /vendor/etc/init/aabox-aapd.rc.
#
# For the AOSP 14 / CM5 variant see the aosp14 branch; that version uses
# aabox-usb-bind.sh + a watchdog wrapper instead of the direct daemon call.
#
# USB gadget switching and fan control live in aabox-usb.rc (same dir).

service aabox_aapd /system/bin/aabox-aapd usb-run
    class main
    user root
    group root
    restart_period 5
    seclabel u:r:su:s0

on boot
    write /proc/sys/kernel/printk "3 4 1 7"
